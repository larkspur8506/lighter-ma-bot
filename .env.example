# Environment template — copy to `.env` and fill in. Never commit `.env`.
#
# Naming note: these are the key names assumed by the task breakdown. T5
# (app/config.py) is the authority — once it lands, align the names here with
# whatever `app/config.py` actually reads, and keep this file in sync.
#
#   cp .env.example .env && chmod 600 .env

# --- Lighter account identity -------------------------------------------------
# Lighter account index for the dedicated bot sub-account.
LIGHTER_ACCOUNT_INDEX=
# API key index of the key pair below (as registered on Lighter).
LIGHTER_API_KEY_INDEX=
# Lighter API private key (hex, 0x-prefixed). This is a trading key, not the
# L1 key — it can place orders but cannot move funds.
LIGHTER_API_PRIVATE_KEY=
# L1 wallet address the Lighter account is bound to.
LIGHTER_L1_ADDRESS=
# mainnet | testnet
LIGHTER_ENVIRONMENT=mainnet

# --- HTTP service (T10) -------------------------------------------------------
# Bearer token required by the three write operations (kill / flatten / dd reset).
ADMIN_TOKEN=
# Bind address/port for uvicorn (the Dockerfile defaults to 0.0.0.0:8100).
HOST=0.0.0.0
PORT=8100

# --- Persistence --------------------------------------------------------------
# SQLite file for positions / orders / fills / events / snapshots.
DB_PATH=./data/state.db
# Optional SQLAlchemy-style URL form, if the adapter uses one. Leave empty to
# derive it from DB_PATH.
DB_URL=

# --- Risk ---------------------------------------------------------------------
# Fraction of equity risked per trade (0.01 = 1%).
RISK_PCT=0.01
