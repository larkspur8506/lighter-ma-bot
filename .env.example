# Environment template — copy to `.env` and fill in. Never commit `.env`.
#
# Naming note: `app/config.py` (landed in T3) is the authority — it reads exactly
# these keys. The five identity/admin keys below have no defaults on purpose: a
# missing one makes the process refuse to start (fail-closed) rather than trade
# on a guessed account index.
#
#   cp .env.example .env && chmod 600 .env

# --- Lighter account identity -------------------------------------------------
# Lighter account index for the dedicated bot sub-account.
LIGHTER_ACCOUNT_INDEX=
# API key index of the key pair below (as registered on Lighter).
LIGHTER_API_KEY_INDEX=
# Lighter API private key (hex, 0x-prefixed). This is the L2 trading key,
# NOT the L1 wallet key.
#
# Security note (verified 2026-10-27 against Lighter docs + live API):
# this key CAN withdraw, but only to the L1 address the account is bound to —
# `SignWithdraw` takes no destination-address parameter, so funds cannot be
# sent anywhere else. Transfers to another owner and fast withdrawals to an
# arbitrary address additionally require the L1 private key signature.
#
# Therefore the exposure of a leaked key is: the attacker can move this
# account's balance to your own wallet. That is why the bot runs on a
# dedicated sub-account funded with only what it may risk — the blast radius
# is that sub-account's balance, not the main account's.
LIGHTER_API_PRIVATE_KEY=
# L1 wallet address the Lighter account is bound to.
LIGHTER_L1_ADDRESS=
# mainnet | testnet
LIGHTER_ENVIRONMENT=mainnet

# --- HTTP service (T10) -------------------------------------------------------
# Bearer token required by the three write operations (kill / flatten / dd reset).
ADMIN_TOKEN=
# Bind address/port for uvicorn (the Dockerfile defaults to 0.0.0.0:8100).
HOST=0.0.0.0
PORT=8100

# --- Persistence --------------------------------------------------------------
# SQLite file for positions / orders / fills / events / snapshots.
DB_PATH=./data/state.db
# Optional SQLAlchemy-style URL form, if the adapter uses one. Leave empty to
# derive it from DB_PATH.
DB_URL=

# --- Proxy (see docs/PROXY.md) ------------------------------------------------
# Lighter's *trading* endpoints (/sendTx, /sendTxBatch, WS /stream) reject US IPs
# with `{"code":20558,"message":"You are accessing Lighter from a restricted
# jurisdiction..."}`; read endpoints work from anywhere. Point this at a local
# HTTP proxy whose egress is in a permitted region (sing-box on 127.0.0.1:8118 in
# the reference setup).
#
# EMPTY = direct connection (the default). An invalid value makes the process
# refuse to start — it is never silently ignored, because "thought we were
# proxied, actually direct" only shows up as a 20558 at the first sendTx.
# Only http:// and https:// are supported (SOCKS would need a new dependency).
# A URL with credentials (http://user:pass@host:port) is supported; it counts as
# a secret exactly like LIGHTER_API_PRIVATE_KEY — keep it in `.env`, never in
# this file, and never paste it into an issue or an alert.
LIGHTER_PROXY_URL=

# --- Risk ---------------------------------------------------------------------
# Fraction of equity risked per trade (0.01 = 1%). Read by app/config.py; the
# legacy live parameter is 1.33%, so production should set RISK_PCT=0.0133.
RISK_PCT=0.01

# The keys below are read by app/sizing.py and app/risk.py (T4) directly — they
# are NOT in app/config.py (which owns identity/service/persistence only). All
# are optional: the documented default is shown on the right. An invalid value
# (e.g. MAX_POSITIONS=-2) makes the process refuse to start instead of silently
# falling back to a wider risk budget.

# User-side leverage cap. The effective leverage is min(this, exchange max),
# where exchange max = 10000 / min_initial_margin_fraction (BTC/ETH 50x, SOL
# 25x). 5x matches the legacy live system and the 700-trade backtest.
LIGHTER_LEVERAGE=5

# Daily loss circuit breaker, as a fraction of the day-start equity (0.05 = -5%).
MAX_DAILY_LOSS_PCT=0.05
# Max entries per day (anti retry-storm).
MAX_TRADES_PER_DAY=4
# Max concurrent positions; one position per symbol is enforced separately.
MAX_POSITIONS=3
# Notional caps as multiples of equity: per symbol, and in total.
MAX_SYMBOL_NOTIONAL_MULT=1.5
MAX_TOTAL_NOTIONAL_MULT=2.5
# Drawdown thresholds. 0 / empty = follow the risk_pct tier (1.33% -> warn 25% /
# kill 30%, 2% -> 30%/40%, 3% -> 40%/50%). Overrides must satisfy
# 0.05 <= warn < kill <= 0.95.
DD_WARN_PCT=
DD_KILL_PCT=
# Isolated margin: before each entry switch the market to isolated at the target
# leverage (idempotent), after the fill allocate collateral (~notional/leverage;
# the venue normalises it and releases it automatically on close). The account
# was switched to isolated on 2026-10-29; leave at 1. 0 = legacy cross behavior.
LIGHTER_ISOLATED_MARGIN=1
# Fill confirmation (2026-10-30): sendTx code=200 only means "accepted by the
# sequencer" -- an IOC order can execute with ZERO fill (price ran past the
# slippage bound before the tick placed it). Entry is booked only after the
# position actually shows up on the exchange; exit only after it is gone.
# Seconds to poll; 0 = single read (offline tests).
LIGHTER_FILL_CONFIRM_S=12
# Entry "worst price" band in bps (default 30), applied on top of the LIVE mid
# captured at order time (not the 4h bar close -- that anchor was 3-4 minutes stale
# and consumed the whole band; see docs/EXECUTOR.md 3.1.2).
# Historical drift between the bar close and order time:
# Measured on Lighter 1m candles (60 four-hour boundaries, 2026-10-19..29): the
# price drifts p50=10bp / p90=18bp / max=58bp within 3.5 min of a bar close, and
# >30bp happens 5% of the time (all three cases at 20:00 UTC). Wider = fewer
# missed signals, worse chase price. Leave empty for 30.
LIGHTER_ENTRY_SLIPPAGE_BPS=
# Signal age gate: entries are allowed only within N minutes of the SIGNAL BAR
# CLOSE. The tick fires at :03/:33, so 30 minutes means "only the first tick after
# the 4h close may open" (a blocked first tick no longer opens hours later on a
# stale bar -- that happened live: the 20:00 signal executed at 03:03).
# Drift vs the bar close (Lighter SOL 1m, 84 four-hour boundaries, 14 days):
#   +3 min  p50 8.3bp / p90 19.3bp / >30bp 5%
#  +33 min  p50 20.8bp / p90 63.5bp / >30bp 36%   <- median 2.5x, 36% blow the band
#  +63 min  p50 24.8bp / p90 73.0bp / >30bp 45%
# Over the window the entry is skipped (event entry_skipped_stale_signal); it is
# not an error, not a failure, and exits/stops are never affected. 0 = off.
LIGHTER_MAX_SIGNAL_AGE_MIN=30
# How many consecutive ticks a `grace` mismatch may stay unsettled before the
# local row is voided as a phantom position (no exchange fill at all).
LIGHTER_GRACE_TICKS=2
# Manual kill switch: block new entries (exits and stop orders are unaffected).
KILL_SWITCH=

# --- Notifications (app/notify.py) ---------------------------------------------
# Same three keys as the HL bot, on purpose: one credential set to maintain, and
# the ops playbook is identical across both bots. ALL THREE ARE OPTIONAL.
#   * both Telegram keys set  -> that channel is used
#   * WECHAT_WEBHOOK_URL set  -> that channel is used
#   * nothing set             -> the notifier is a no-op (executor only logs;
#                                byte-for-byte the pre-integration behavior)
# To go quiet, blank them out -- there is deliberately no extra on/off switch
# (every switch is one more "I thought it was on" state in production).
# Entries / exits / stop fills / stop fills settled offline are pushed.
# Failed pushes are logged as warnings and NEVER touch the trading path.
# The bot token and the webhook key are credentials: `.env` only, chmod 600,
# never in an issue or an alert.
WECHAT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
