# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual envs
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Secrets & runtime state
# NOTE: a pattern without a slash matches at any depth in git, so `*.key`
# already covers `conf/lighter.key`. Files that hold private keys have no
# legitimate reason to be committed, anywhere in this tree.
.env
.env.*
!.env.example
.envrc
*.key
*.pem
*.p12
id_rsa*
id_ed25519*
secrets/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
